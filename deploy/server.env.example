# Copy this file to /data/hensun-desk/runtime/server.env on the server and
# enter the confidential values there. Never commit or paste the filled file.

APP_ENV=production
DATABASE_URL=
ADMIN_API_KEY=
JWT_SECRET=
DEVICE_CREDENTIAL_PEPPER=
MEMORY_MASTER_KEY=

PROVIDER_MODE=custom
PROVIDER_TIMEOUT_SECONDS=30
ASR_PROTOCOL=qwen-chat-completions
ASR_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_API_KEY=
ASR_MODEL=qwen3-asr-flash
QWEN_REALTIME_ASR_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_REALTIME_ASR_MODEL=qwen3-asr-flash-realtime

TTS_PROTOCOL=dashscope-generation
TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
TTS_API_KEY=
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry
TTS_LANGUAGE_TYPE=Chinese
QWEN_REALTIME_TTS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_REALTIME_TTS_MODEL=qwen3-tts-flash-realtime

LLM_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=

FALLBACK_ENABLED=true
FALLBACK_API_KEY=
WEB_SEARCH_MCP_ENABLED=false
WEB_SEARCH_QWEN_ENABLED=true
WEB_SEARCH_QWEN_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WEB_SEARCH_QWEN_MODEL=qwen-plus
WEB_SEARCH_MCP_API_KEY=

OTA_SIGNING_PUBLIC_KEY=
OTA_BASE_URL=https://ota.hensun-desk.top/v1/ota/
DEVICE_WS_URL=wss://voice.hensun-desk.top/v1/device/ws
GATEWAY_ID=gateway-hensun-desk-1

CORS_ORIGINS=https://staging.hensun-desk.top,https://hensun-desk.top,https://www.hensun-desk.top
WEB_APP_URL=https://hensun-desk.top
SESSION_COOKIE_SECURE=true

EMAIL_DELIVERY_MODE=smtp
EMAIL_OTP_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

FAMILY_MODE_ENABLED=false

# Candidate TTS release gates: set true only after recorded real-device acceptance.
VOLC_TTS_API_KEY=
VOLC_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
VOLC_TTS_VALIDATED=false
QWEN_INSTRUCT_VALIDATED=false
# Logical queued payload budget per provider session (not total process RSS).
PROVIDER_AUDIO_BUFFER_BYTES=2097152
PROVIDER_EVENT_BUFFER_SIZE=256
